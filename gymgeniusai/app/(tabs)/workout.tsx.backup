    paddingHorizontal: 16,
    paddingVertical: 8,
    borderRadius: 20,
    marginRight: 8,
    borderWidth: 1,
  },
  activityChipText: {
    fontSize: 14,
    fontWeight: '500',
  },
  intensityButtons: {
    flexDirection: 'row',
    gap: 8,
  },
  intensityButton: {
    flex: 1,
    paddingVertical: 12,
    borderRadius: 8,
    alignItems: 'center',
    borderWidth: 1,
  },
  intensityButtonText: {
    fontSize: 14,
    fontWeight: '600',
  },
  modalActions: {
    paddingHorizontal: 20,
